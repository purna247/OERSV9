# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

PORT=5000

# PostgreSQL connection string
# Special characters in passwords must be URL-encoded:
#   @ → %40  |  # → %23  |  $ → %24  |  ! → %21
DATABASE_URL=postgres://postgres:your_password@localhost:5432/oers_v9

# JWT signing secret — use a long random string in production
JWT_SECRET=your_jwt_secret_here

# bcrypt salt rounds (10 is a good default; higher = slower but more secure)
BCRYPT_ROUNDS=10

# ─── Admin seed credentials (used by: node config/seed.js) ───────────────────
# These set the initial super-admin account. Change before first deployment.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe@1234
